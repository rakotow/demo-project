# Polymarket CLOB credentials
# Your EVM private key (Polygon wallet) — keep this secret, never commit .env!
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Polymarket API key (from https://polymarket.com/profile -> API keys)
CLOB_API_KEY=your-api-key
CLOB_SECRET=your-api-secret
CLOB_PASSPHRASE=your-api-passphrase

# Trade sizing
# USDC amount to stake per trade
TRADE_SIZE_USDC=5.0

# Price threshold — only trade when price >= this value (default 0.80)
PRICE_THRESHOLD=0.80

# Seconds before market close to start looking for entry
ENTRY_WINDOW_SECONDS=40

# Polymarket chain ID (137 = Polygon mainnet)
CHAIN_ID=137
